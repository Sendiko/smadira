<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/css/output.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
</head>
<body class="bg-surface text-gray-900 font-sans antialiased overflow-x-hidden relative min-h-screen flex items-center justify-center">

    <div class="absolute inset-0 bg-surface-container-lowest z-0"></div>
    <div class="absolute inset-0 bg-gradient-135 from-primary/5 to-transparent z-0"></div>

    <div class="relative z-10 w-full max-w-md px-4 sm:px-0 mt-[-5vh]">
        <a href="/" class="flex flex-col items-center gap-3 mb-10 hover:-translate-y-1 transition-transform group">
            <div class="w-16 h-16 rounded-full bg-gradient-135 from-primary to-primary-container flex items-center justify-center text-white font-bold text-3xl shadow-ambient group-hover:shadow-ambient-hover group-hover:scale-105 transition-all">
                <i class="uil uil-graduation-cap"></i>
            </div>
            <span class="font-display font-black text-3xl tracking-tight text-gray-900">OSIS SMA DIRA</span>
        </a>

        <div class="bg-surface-container-lowest rounded-[2rem] p-10 shadow-ambient-hover border border-surface-variant/20">
            <div class="text-center mb-8">
                <h1 class="text-2xl font-display font-bold text-gray-900 tracking-tight">Login Portal Admin</h1>
                <p class="text-gray-500 mt-2 font-medium">Masuk untuk mengelola data OSIS</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-6 px-4 py-3 bg-red-50/50 border border-red-100 text-red-600 rounded-2xl font-medium text-sm text-center shadow-sm">
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST" class="space-y-5">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2 ml-1">Username</label>
                    <input type="text" name="username" required
                        class="w-full px-5 py-4 border border-surface-variant/30 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all bg-surface-container-low font-medium">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2 ml-1">Password</label>
                    <input type="password" name="password" required
                        class="w-full px-5 py-4 border border-surface-variant/30 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all bg-surface-container-low font-medium">
                </div>
                
                <button type="submit"
                    class="w-full py-4 px-6 mt-4 bg-gradient-135 from-primary to-primary-container text-white font-bold rounded-xl shadow-ambient hover:shadow-ambient-hover hover:-translate-y-1 transition-all flex items-center justify-center gap-3">
                    Masuk
                    <i class="uil uil-sign-in-alt text-xl"></i>
                </button>
            </form>
            
            <div class="mt-8 text-center pt-6 border-t border-surface-variant/20">
                <a href="/" class="text-sm font-semibold text-gray-400 hover:text-primary transition-colors inline-flex items-center gap-2">
                    <i class="uil uil-arrow-left"></i> Kembali ke Beranda
                </a>
            </div>
        </div>
    </div>

</body>
</html>
