<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="/css/output.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
</head>

<body class="bg-surface text-gray-900 font-sans antialiased overflow-x-hidden min-h-screen flex flex-col">

    <!-- Navigation -->
    <nav
        class="bg-surface/70 backdrop-blur-[20px] border-b border-surface-variant/30 z-50 sticky top-0 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-24">
                <a href="/" class="flex items-center gap-4 group">
                    <div
                        class="w-12 h-12 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary font-bold text-xl shadow-ambient group-hover:-translate-x-1 transition-all">
                        <i class="uil uil-arrow-left"></i>
                    </div>
                    <span
                        class="font-display font-bold text-xl tracking-tight text-gray-900 group-hover:text-primary transition-colors">Kembali
                        ke Beranda</span>
                </a>
                <div class="hidden md:flex">
                    <span
                        class="px-6 py-2.5 bg-surface-container-low rounded-full text-xs font-bold uppercase tracking-widest text-primary shadow-sm">Council
                        Pulse</span>
                </div>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <div class="bg-gradient-135 from-primary to-primary-container text-white pt-24 pb-32 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <h1 class="text-5xl md:text-6xl font-display font-extrabold tracking-tight mb-8 text-white">Semua Agenda
                OSIS</h1>
            <p class="text-primary-dim max-w-2xl mx-auto text-xl font-medium leading-relaxed">Katalog arsip seluruh
                kegiatan dan program kerja yang diinisiasi oleh OSIS SMA DIRA.</p>
        </div>
        <!-- Decorative bg -->
        <div class="absolute -top-40 -right-40 w-96 h-96 bg-white/5 rounded-full blur-3xl"></div>
    </div>

    <!-- Main Content Grid -->
    <main class="flex-grow py-24 -mt-16 bg-surface relative z-10">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="space-y-12">
                <% if(prokers && prokers.length> 0) { %>
                    <% prokers.forEach(function(proker) { %>
                        <div
                            class="bg-surface-container-lowest rounded-[2rem] p-10 shadow-ambient-hover transform transition-transform duration-300 hover:-translate-y-1 border border-surface-container-highest/20">
                            <!-- Metadata -->
                            <div
                                class="mb-6 inline-flex items-center px-4 py-2 bg-tertiary-fixed text-tertiary-container text-xs font-bold uppercase tracking-widest rounded-full">
                                <%= new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long' }).format(new Date(proker.tanggal_pelaksanaan)) %>, <%= new Date(proker.tanggal_pelaksanaan).getFullYear() %>
                            </div>

                            <!-- Hierarchy High Contrast: Title -->
                            <h4 class="text-3xl font-display font-bold text-gray-900 mb-6 tracking-tight leading-tight">
                                <%= proker.judul %>
                            </h4>

                            <!-- The Body Text -->
                            <p class="text-lg text-gray-600 font-medium leading-relaxed mb-4">
                                <%= proker.deskripsi %>
                            </p>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="py-24 text-center bg-surface-container-low rounded-[2.5rem]">
                                    <h4 class="text-xl font-display font-bold text-gray-500 mb-2">Belum Ada Agenda
                                        Terarsip</h4>
                                    <p class="text-gray-400 font-medium">Council Pulse saat ini masih kosong.</p>
                                </div>
                                <% } %>
            </div>
        </div>
    </main>

    <footer class="py-12 bg-surface-container-lowest text-center">
        <p class="text-sm text-gray-500 font-medium tracking-wide">&copy; 2026 OSIS SMA DIRA. Didesain dengan gaya The
            Academic Vanguard.</p>
    </footer>

</body>

</html>